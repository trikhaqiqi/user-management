# Copy to .env (or run `make env`, which also generates the secrets below).
# Never commit .env.

# ---- Docker Compose (Postgres container) ---------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=user_management

# ---- Shared ------------------------------------------------------------------
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/user_management?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Shared secret the gateway presents to services (>= 32 chars).
INTERNAL_SERVICE_TOKEN=
# Ed25519 key pair, base64 of the PEM. auth-service signs, the gateway verifies.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Server-side key mixed into OTP hashes (base64, >= 32 bytes).
OTP_PEPPER=

# ---- api-gateway ---------------------------------------------------------------
GATEWAY_PORT=8080
AUTH_SERVICE_URL=http://localhost:8091
CORE_SERVICE_URL=http://localhost:8092
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated CIDRs allowed to set X-Forwarded-For. Empty = trust none.
TRUSTED_PROXIES=
PROXY_TIMEOUT=15s
MAX_BODY_BYTES=1048576
OPENAPI_SPEC_PATH=../docs/openapi.yaml
# Log request/response bodies at the gateway (JSON only; passwords, OTPs and
# tokens are replaced with [REDACTED], emails masked). Feeds the Grafana
# dashboard. Consider false in production.
LOG_HTTP_BODIES=true
RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_SENSITIVE_PER_15_MINUTES=10

# ---- auth-service --------------------------------------------------------------
AUTH_SERVICE_PORT=8091
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
SESSION_MAX_AGE=720h
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT=15m
PASSWORD_RESET_TTL=15m
PASSWORD_RESET_COOLDOWN=60s
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# ---- OTP (auth-service and core-service) ----------------------------------------
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60s
OTP_MAX_PER_HOUR=5

# ---- core-service --------------------------------------------------------------
CORE_SERVICE_PORT=8092

# ---- Mail ---------------------------------------------------------------------------
# resend: real delivery through the Resend API (needs RESEND_API_KEY). Without a
#         verified domain, MAIL_FROM must be onboarding@resend.dev and Resend only
#         delivers to the email address that owns the Resend account.
# smtp:   send to Mailpit (docker compose; inbox UI at http://localhost:8025)
# file:   write .eml files into MAIL_OUTBOX_DIR (no extra software needed)
MAIL_DRIVER=resend
MAIL_OUTBOX_DIR=../tmp/outbox
MAIL_FROM="Godigi <onboarding@resend.dev>"
RESEND_API_KEY=
SMTP_ADDR=localhost:1025
# Driver used inside docker compose (smtp = Mailpit). Set to resend for real mail.
COMPOSE_MAIL_DRIVER=smtp
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- Monitoring (docker compose --profile monitoring) ------------------------------
# Grafana: http://localhost:3030 (user: admin)
GRAFANA_ADMIN_PASSWORD=
GRAFANA_HOST_PORT=3030
LOKI_HOST_PORT=3101
